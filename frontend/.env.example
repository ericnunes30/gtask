# URL da API do backend (inclua prefixo se houver)
# Ex.: http://localhost:3334/api/v1 para Nest com prefixo 'api/v1'
VITE_BACKEND_API_URL=http://localhost:3334/api/v1

# URL do Socket.io (opcional). Se não definido, será derivado de VITE_BACKEND_API_URL.
# Ex.: ws://localhost:3334
# VITE_SOCKET_URL=ws://localhost:3334

