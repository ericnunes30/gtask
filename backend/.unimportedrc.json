{
  "entry": ["src/main.ts", "src/console.ts"],
  "extensions": [".ts", ".js"],
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "test/**",
    "scripts/**",
    "**/*.spec.ts",
    "**/*.d.ts",
    "src/config/*.debug.ts",
    "src/database/**",
    "src/modules/whatsapp/**"
  ],
  "ignoreUnimported": [
    "src/database/data-source.ts",
    "src/database/migrations/*.ts",
    "src/config/cors.config.debug.ts",
    "src/modules/events/services/timer.service.ts",
    "src/modules/notification/dto/create-notification.dto.ts",
    "src/modules/notification/dto/update-notification.dto.ts",
    "src/modules/permission/interfaces/permission.interface.ts",
    "src/modules/user/dto/user-response.dto.ts",
    "src/modules/whatsapp/**"
  ],
  "ignoreUnused": [
    "@nestjs/platform-express",
    "@nestjs/platform-socket.io",
    "@nestjs/axios",
    "@types/luxon"
  ],
  "ignoreUnresolved": [
    "bufferutil",
    "utf-8-validate"
  ]
}
